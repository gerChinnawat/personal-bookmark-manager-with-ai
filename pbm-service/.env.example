POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bookmark_service
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmark_service?schema=public"

# Auth0 (values from API_DESIGN.md §1; JWKS URI from the discovery document)
AUTH0_ISSUER="https://dev-yg.us.auth0.com/"
AUTH0_AUDIENCE="https://bbl-candidate-test-api"
AUTH0_JWKS_URI="https://dev-yg.us.auth0.com/.well-known/jwks.json"

# CORS: origin allowed to call this API (pbm-ui's dev server). Defaults to
# http://localhost:3000 in main.ts if unset.
CORS_ORIGIN="http://localhost:3000"
